# 本地材料与大文件（不入库）
refs/
outputs/
_gh_push/
_push/
.workbuddy/
*.bak-*

# 文献与数据文件（受出版社许可限制 / 体积过大）
*.pdf
*.zip
*.xml
*.ndjson

# 办公文件与临时文件
*.xlsx
*.csv
~$*
*.tmp

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# 语料库自制证据卡与目录（PMC 开放获取逐字摘录，许可随卡注明，总体积 ~1.1MB）
!docs/corpus/**/*.pdf
